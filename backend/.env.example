# Copy this file to .env and fill in your keys. NEVER commit .env.
# Everything below can run on FREE tiers. See README "Free setup".

# --- Gemini (free key): VideoClip, Muse, Trends - and Scripting/C-Pilot if no text key below ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Live Google Search for Trends needs a paid Gemini tier - leave false on the free tier
GEMINI_SEARCH=false

# --- Text for Scripting + C-Pilot (any OpenAI-compatible API) ---
# Free option: Groq  -> https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_TEXT_MODEL=openai/gpt-oss-120b
# Paid OpenAI instead: set your sk-... key, empty OPENAI_BASE_URL, and e.g. OPENAI_TEXT_MODEL=gpt-6-luna

# --- Images (free): Cloudflare Workers AI, 10,000 neurons/day ---
# Account ID: Cloudflare dashboard sidebar. Token: My Profile -> API Tokens -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Paid Gemini images instead: IMAGE_PROVIDER=gemini and GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_PROVIDER=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- YouTube trending (free, 10,000 quota units/day) ---
# Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
TRENDS_REGION=IN

PORT=3000
